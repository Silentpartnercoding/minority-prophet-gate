{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "releasewarden-experimental",
  "main": "src/index.mjs",
  "preview_urls": false,
  "compatibility_date": "2026-08-14",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "releasewarden-experimental",
      "database_id": "dbfbb71b-0535-40bb-b004-1a6a0c850976",
      "migrations_dir": "migrations"
    }
  ]
}
